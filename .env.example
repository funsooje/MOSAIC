# Copy to .env and fill in. .env is gitignored.

# GeoMetrics PostgreSQL store
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=geometrics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:@localhost:5434/geometrics

# Legacy GTL database, only needed to re-run scripts/migrate_gtl.py
GTL_DSN="host=localhost port=5436 dbname=gtl user=u_gtl password="
